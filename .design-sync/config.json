{
  "shape": "package",
  "pkg": "mitchjmiller-com",
  "globalName": "M2DS",
  "buildCmd": "node scripts/build-ds-css.mjs && npx tsc -p tsconfig.ds.json",
  "srcDir": "src/ds",
  "tsconfig": "tsconfig.ds.json",
  "cssEntry": "src/ds/ds.css",
  "guidelinesGlob": [],
  "provider": {
    "component": "AgencyRoot",
    "props": {
      "page": "default"
    }
  },
  "overrides": {
