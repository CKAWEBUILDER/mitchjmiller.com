    },
    "SiteFooter": {
      "cardMode": "column"
    },
    "CTABand": {
      "cardMode": "column"
    },
    "LifecycleStrip": {
      "cardMode": "column"
    },
    "BrandMarquee": {
      "cardMode": "column"
    },
    "Stage": {
      "cardMode": "column"
    },
    "Section": {
      "cardMode": "column"
    },
    "Split": {
      "cardMode": "column"
    },
    "ProcessSteps": {
      "cardMode": "column"
    },
    "Grid": {
      "cardMode": "column"
    },
    "WorkCard": {
      "cardMode": "column"
    }
  }
}