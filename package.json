{
  "name": "mitchjmiller-com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-astro-staging.mjs && astro dev --host 127.0.0.1 --port 5191",
    "build": "node scripts/prepare-astro-staging.mjs && astro build && node scripts/finalize-parity.mjs && node scripts/share-cards.mjs && node scripts/verify-parity.mjs && node scripts/verify-agency.mjs && node scripts/verify-standards.mjs",
    "build:github": "node -e \"console.error('Production is gated pending theme approval and completion of the HTML migration. See PROJECT.md.'); process.exit(1)\"",
    "cloudflare:login": "npm_config_cache=.npm-cache npx -y wrangler login --browser=false",
    "deploy:cloudflare": "node -e \"console.error('Production is gated pending theme approval and completion of the HTML migration. See PROJECT.md.'); process.exit(1)\"",
    "serve": "astro preview --host 127.0.0.1 --port 5191",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.parity.json --noEmit",
    "build:production": "node -e \"console.error('Production is gated pending theme approval and completion of the HTML migration. See PROJECT.md.'); process.exit(1)\"",
    "dev:legacy": "vite --config vite.config.ts --host 0.0.0.0",
    "build:legacy": "vite build --config vite.config.ts && node scripts/create-route-copies.mjs",
    "serve:legacy": "vite preview --config vite.config.ts --host 0.0.0.0",
    "build:production:legacy": "VITE_SITE_INDEXABLE=true npm run build",
    "build:github:legacy": "BASE_PATH=/mitchjmiller.com/ vite build --config vite.config.ts && node scripts/create-route-copies.mjs",
    "build:staging": "npm run build",
    "build:release-candidate": "SITE_BUILD_MODE=release node scripts/prepare-astro-staging.mjs && SITE_BUILD_MODE=release astro build && SITE_BUILD_MODE=release node scripts/finalize-parity.mjs && SITE_BUILD_MODE=release node scripts/share-cards.mjs && SITE_BUILD_MODE=release node scripts/verify-parity.mjs && SITE_BUILD_MODE=release node scripts/verify-agency.mjs && SITE_BUILD_MODE=release node scripts/verify-standards.mjs",
    "verify:agency": "node scripts/verify-agency.mjs",
    "qa:serve": "node scripts/qa/serve.mjs dist 5189",
    "qa:crawl": "node scripts/qa/crawl.mjs --base http://127.0.0.1:5189",
    "qa:browser": "node scripts/qa/browser.mjs --base http://127.0.0.1:5189",
    "narrate": "node scripts/narrate.mjs",
    "verify:standards": "node scripts/verify-standards.mjs"
  },
  "dependencies": {
    "@astrojs/react": "6.0.5",
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.11",
    "@tanstack/react-query": "^5.81.5",
    "@vitejs/plugin-react": "^4.6.0",
    "astro": "7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.19.2",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.468.0",
    "marked": "^18.0.7",
    "mermaid": "^11.16.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "wouter": "^3.3.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "axe-core": "4.13.0",
    "esbuild": "0.25.12",
    "puppeteer-core": "^25.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
