---
import brands from '../data/brands.json';
interface Props { heading?: string; id?: string; lang?: 'en' | 'es'; }
const { id = 'brands', lang = 'en' } = Astro.props;
// Spanish pilot strings (site standards 2026-09-24); English stays the data file's label.
// 2026-10-02: heading is "Trusted by" (Mitch); Spanish equivalent pending native-speaker check.
const text = lang === 'es'
  ? { heading: 'Con la confianza de', pause: 'Pausar logotipos', resume: 'Reanudar logotipos', group: 'Logotipos de marcas. Coloca el foco aquí para pausar el desplazamiento.', inHouse: 'Experiencia interna en', clients: 'Trabajo con clientes como' }
  : { heading: brands.label, pause: 'Pause logos', resume: 'Resume logos', group: 'Brand logos. Focus here to pause scrolling.', inHouse: 'In-house experience at', clients: 'Client work includes' };
const heading = Astro.props.heading ?? text.heading;
const list = brands.brands.filter(brand => brand.logo);
// One loop scrolls one copy of the list: about 15 s per logo keeps the rotation deliberately slow
// (2026-10-02, Mitch: slow the rotation noticeably; previously 6 s per logo / 42 s minimum).
const duration = Math.max(75, list.length * 15);
// Text twin of the carousel (2026-10-02): crawlers and LLMs cannot read an image-only marquee,
// so the same associations render as plain text below it, sourced from brands.json. Entries whose
// exact identity is unresolved (PROJECT.md open questions) are skipped until Mitch confirms them;
// independent project marks (kind "project") are not "trusted by" evidence and stay out too.
const unresolved = new Set(["St. Luke's Health", 'UCSF', 'Insomnia Cafe', 'Blue Planet Adventures', 'Baylor Health']);
const joinNames = (names: string[]) => names.length > 1 ? `${names.slice(0, -1).join(', ')} ${lang === 'es' ? 'y' : 'and'} ${names[names.length - 1]}` : names.join('');
const employers = joinNames(brands.brands.filter(brand => brand.kind === 'employer' && !unresolved.has(brand.name)).map(brand => brand.name));
const clients = joinNames(brands.brands.filter(brand => brand.kind === 'client' && !unresolved.has(brand.name)).map(brand => brand.name));
---
<section class="ag-marquee" aria-labelledby={`${id}-label`} data-marquee>
  <div class="ag-wrap ag-marquee-head">
    <p class="ag-marquee-label" id={`${id}-label`}>{heading}</p>
    <button class="ag-marquee-toggle" type="button" aria-pressed="false" aria-controls={`${id}-track`} data-marquee-toggle data-label-pause={text.pause} data-label-resume={text.resume} hidden>{text.pause}</button>
  </div>
  <div class="ag-marquee-viewport" tabindex="0" role="group" aria-label={text.group}>
    <div class="ag-marquee-track" id={`${id}-track`} style={`--ag-marquee-duration:${duration}s`}>
      {[false, true].map(duplicate => (
        <ul aria-hidden={duplicate ? 'true' : undefined} data-marquee-copy={duplicate ? 'duplicate' : 'primary'}>
          {list.map(brand => (
            <li title={brand.name} data-brand={brand.name}>
              <img src={brand.logo!} alt={duplicate ? '' : brand.name} loading="eager" width={'width' in brand ? brand.width : undefined} height={'height' in brand ? brand.height : undefined} />
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</section>
<div class="ag-marquee-names">
  <div class="ag-wrap">
    <p>{text.inHouse} {employers}.</p>
    <p>{text.clients} {clients}.</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach(marquee => {
    const toggle = marquee.querySelector<HTMLButtonElement>('[data-marquee-toggle]');
    if (!toggle) return;
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const paused = toggle.getAttribute('aria-pressed') !== 'true';
      toggle.setAttribute('aria-pressed', String(paused));
      marquee.dataset.paused = String(paused);
      toggle.textContent = (paused ? toggle.dataset.labelResume : toggle.dataset.labelPause) || '';
    });
  });
</script>
