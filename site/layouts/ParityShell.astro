---
/**
 * Production site shell (header, footer, head metadata) for pages that are not
 * part of the archived production snapshot: /lab/, the population workbench and
 * /clients/. Metadata mirrors site/pages/[...path].astro; scripts/finalize-parity.mjs
 * owns the final robots/analytics policy per build mode.
 */
import ParityShellReact from '../components/ParityShell';
import { headshot } from '../../baseline/src/lib/images';
import '../../baseline/src/index.css';
import '../components/parity/parity.css';

interface Props { path: string; title: string; description: string; image?: string; }
const { path, title, description, image } = Astro.props;
const canonical = new URL(path, 'https://mitchjmiller.com').href;
const ogImage = new URL(image || headshot, 'https://mitchjmiller.com').href;
const release = process.env.SITE_BUILD_MODE === 'release';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={release ? 'index, follow' : 'noindex, nofollow, noarchive'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <ParityShellReact path={path}><slot /></ParityShellReact>
    <script>import '../components/parity/enhance';</script>
  </body>
</html>
