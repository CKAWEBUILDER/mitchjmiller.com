---
/**
 * Compatibility wrapper kept for the lab, workbench and clients pages: the
 * production shell is now the agency shell (AgencyLayout.astro, 2026-09-14).
 */
import AgencyLayout from './AgencyLayout.astro';
interface Props { path: string; title: string; description: string; image?: string; }
const { path, title, description, image } = Astro.props;
---
<AgencyLayout path={path} title={title} description={description} image={image}>
  <slot name="head" slot="head" />
  <slot />
</AgencyLayout>
