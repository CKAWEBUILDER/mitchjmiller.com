---
interface Props {title:string; description?:string; canonical?:string;}
const {title, description='Static HTML content proof for the portfolio redesign.', canonical}=Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex, follow"/><meta name="description" content={description}/><title>{title} · Mitchell Miller</title>{canonical&&<link rel="canonical" href={canonical}/>}<link rel="icon" href="/favicon.svg"/></head><body><a class="skip" href="#main">Skip to content</a><header><a class="brand" href="/">MITCH MILLER <span>Design review</span></a><nav aria-label="Review navigation"><a href="/themes/editorial/">Editorial direction</a><a href="/themes/atelier/">Research atelier</a><a href="/proof/">HTML proofs</a></nav></header><main id="main"><p class="notice">CONTENT PROOF · THEME UNDER REVIEW · NOT PRODUCTION</p><slot/></main><footer>Staging content is delivered as HTML. Public launch follows design review.</footer></body></html>
<style is:global>
:root{font-family:Arial,Helvetica,sans-serif;color:#162226;background:#fafaf8;font-synthesis:none}*{box-sizing:border-box}body{margin:0;line-height:1.7;font-size:17px}a{color:#982f20;text-underline-offset:4px}a:focus-visible{outline:3px solid #c84c31;outline-offset:4px}.skip{position:absolute;top:-100px}.skip:focus{top:12px;background:white;padding:8px}header,main,footer{max-width:1100px;margin:auto;padding:25px}header{display:flex;justify-content:space-between;gap:22px;border-bottom:1px solid #cbd0cb}.brand{font-weight:800;color:#162226;text-decoration:none;letter-spacing:-.025em}.brand span{display:block;font-size:12px;font-weight:400;letter-spacing:.08em;text-transform:uppercase;color:#586466}nav{display:flex;flex-wrap:wrap;gap:20px;align-items:center;font-size:14px}main{padding-top:35px;min-height:65vh}h1{font-size:clamp(36px,5vw,65px);line-height:1.08;letter-spacing:-.045em;max-width:970px;margin:20px 0 25px}h2{font-size:30px;line-height:1.2;margin:45px 0 18px;letter-spacing:-.025em}h3{line-height:1.3}p{max-width:820px;margin:0 0 22px}.notice{font-size:12px;letter-spacing:.12em;color:#626b69;margin-bottom:20px}.deck{font-size:22px;line-height:1.5;color:#455552}.facts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;padding:25px 0;border-top:1px solid #cbd0cb;border-bottom:1px solid #cbd0cb;margin:30px 0}.facts strong{display:block;font-size:28px}.facts span,.facts small{display:block}.facts small,figcaption{font-size:13px;color:#586460}.body{max-width:860px}.body img,figure img{max-width:100%;height:auto}figure{margin:25px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18px}.card{border:1px solid #cbd0cb;padding:24px;background:white}.card h2{font-size:25px;margin:0 0 12px}.card p{font-size:16px}.card a{display:inline-block;margin-top:6px}blockquote{border-left:4px solid #b64229;padding-left:20px;color:#44554c}pre{overflow:auto;padding:18px;background:#e9eee8;font-size:14px}table{border-collapse:collapse;max-width:100%;font-size:15px}td,th{border:1px solid #bec8bf;padding:10px}footer{border-top:1px solid #cbd0cb;font-size:13px;color:#5f6a63;margin-top:45px}@media(max-width:720px){header{display:block}nav{margin-top:20px}.grid,.facts{grid-template-columns:1fr}header,main,footer{padding-left:20px;padding-right:20px}.deck{font-size:19px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}}
</style>
