---
/**
 * Self-contained layout for the /lab/population-workbench/ pages.
 * Light editorial direction: cream paper, ink, vermilion accent, Arial/Helvetica.
 * The site-migration lane can replace this with the final site layout; all page
 * content lives in site/components/workbench/ and needs only one import.
 *
 * Indexing: staging policy for this branch is noindex on every page (see
 * scripts/prepare-astro-staging.mjs `_headers`). The final layout owns the
 * production robots decision.
 */
interface Props { title: string; description: string; canonical?: string; }
const { title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex, follow"/>
<meta name="description" content={description}/>
<title>{title} · Mitchell Miller</title>
{canonical && <link rel="canonical" href={canonical}/>}
<link rel="icon" href="/favicon.svg"/>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="site-header">
  <a class="brand" href="/">MITCH MILLER <span>Lab</span></a>
  <nav aria-label="Lab navigation">
    <a href="/lab/population-workbench/">Population workbench</a>
    <a href="/lab/population-workbench/methodology/">Methodology</a>
    <a href="/contact/?topic=population-simulation">Start a conversation</a>
  </nav>
</header>
<main id="main"><slot/></main>
<footer class="site-footer">
  <p>Free lab tool on public Census microdata. Runs entirely in your browser; nothing you type is sent anywhere.</p>
  <p><a href="/lab/population-workbench/methodology/">Methodology, limitations and reuse</a> · <a href="/">mitchjmiller.com</a></p>
</footer>
</body>
</html>
<style is:global>
:root{--paper:#fafaf7;--ink:#1d211e;--verm:#cc3524;--muted:#60655e;--rule:#d8d9d2;--card:#ffffff;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--paper);font-synthesis:none}
*{box-sizing:border-box}
body{margin:0;line-height:1.65;font-size:17px;background:var(--paper)}
a{color:var(--verm);text-underline-offset:4px}
a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--verm);outline-offset:3px}
.skip{position:absolute;top:-100px;left:12px}
.skip:focus{top:12px;background:#fff;padding:8px;z-index:10}
.site-header,main,.site-footer{max-width:1180px;margin:auto;padding:22px 26px}
.site-header{display:flex;justify-content:space-between;align-items:flex-start;gap:22px;border-bottom:1px solid var(--rule)}
.brand{font-weight:800;color:var(--ink);text-decoration:none;letter-spacing:-.025em;line-height:1.1}
.brand span{display:block;font-size:12px;font-weight:400;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-top:4px}
.site-header nav{display:flex;flex-wrap:wrap;gap:18px;align-items:center;font-size:14px;padding-top:4px}
.site-header nav a{color:var(--ink)}
main{padding-top:34px;min-height:60vh}
h1{font-size:clamp(34px,4.6vw,58px);line-height:1.06;letter-spacing:-.04em;max-width:900px;margin:12px 0 20px}
h2{font-size:26px;line-height:1.2;letter-spacing:-.02em;margin:44px 0 14px}
h3{font-size:19px;line-height:1.3;margin:28px 0 10px}
p,li{max-width:760px}
p{margin:0 0 18px}
.kicker{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0}
.deck{font-size:21px;line-height:1.45;color:#3d433f;max-width:820px}
table{border-collapse:collapse;font-size:15px;max-width:100%}
td,th{border:1px solid var(--rule);padding:8px 12px;text-align:left;vertical-align:top}
th{background:#f1f2ec;font-weight:700}
.table-scroll{overflow-x:auto;margin:0 0 22px}
.site-footer{border-top:1px solid var(--rule);font-size:13px;color:var(--muted);margin-top:48px}
.site-footer p{margin:0 0 6px}
@media(max-width:720px){.site-header{display:block}.site-header nav{margin-top:14px}.site-header,main,.site-footer{padding-left:18px;padding-right:18px}.deck{font-size:18px}body{font-size:16px}}
@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important;transition:none!important}}
</style>
