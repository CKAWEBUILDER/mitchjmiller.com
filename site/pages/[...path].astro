---
/**
 * Archived production routes (53 public + 4 placeholders) rendered from the
 * baseline React pages inside the agency shell. The home page is a separate
 * Astro page (site/pages/index.astro) since the 2026-09-14 redesign; the
 * standalone SFC report is copied verbatim by scripts/prepare-astro-staging.mjs.
 */
import AgencyLayout from '../layouts/AgencyLayout.astro';
import ParityPage, { parityRoutes, parityMetadata } from '../components/ParityPage';
import { caseStudies } from '../../baseline/src/lib/data';
import { visibleBlogPosts, studyNotes } from '../../baseline/src/lib/published';
import { site, personJsonLd, breadcrumbJsonLd, graph } from '../lib/agency';
import { shareFor } from '../lib/share';

export function getStaticPaths() {
  return parityRoutes.filter(route => !route.standalone && route.path !== '/').map(route => ({
    params: { path: route.path.slice(1) },
    props: { path: route.path },
  }));
}
const { path } = Astro.props;
const route = parityMetadata(path)!;
const canonicalPath = `${path}/`;
const monthIndex: Record<string, string> = { January: '01', February: '02', March: '03', April: '04', May: '05', June: '06', July: '07', August: '08', September: '09', October: '10', November: '11', December: '12' };
const isoDate = (value?: string) => {
  if (!value) return undefined;
  if (/^\d{4}-\d{2}(-\d{2})?$/.test(value)) return value;
  const day = value.match(/^([A-Z][a-z]+) (\d{1,2}), (\d{4})$/);
  if (day && monthIndex[day[1]]) return `${day[3]}-${monthIndex[day[1]]}-${day[2].padStart(2, '0')}`;
  const match = value.match(/^([A-Z][a-z]+) (\d{4})$/);
  return match && monthIndex[match[1]] ? `${match[2]}-${monthIndex[match[1]]}` : undefined;
};
const jsonLd: unknown[] = [];
// A post may name its hero (a site path to a PNG/JPG poster) in its data; otherwise the card
// uses the poster of the post's first declared embed (site/lib/share.ts), else the text card.
// A post may instead bring a ready-made 1200×630 card ({ src, alt }), used as-is.
const postData = path.startsWith('/blog/') && !path.startsWith('/blog/studying/') ? visibleBlogPosts.find(entry => `/blog/${entry.slug}` === path) as { hero?: string | { src?: string; alt?: string }; card?: { src: string; alt: string }; title?: string } | undefined : undefined;
const heroSrc = typeof postData?.hero === 'string' ? postData.hero : postData?.hero?.src;
const poster = heroSrc && /\.(png|jpe?g)$/i.test(heroSrc) ? { src: heroSrc, title: (typeof postData?.hero === 'object' && postData.hero.alt) || postData?.title || route.title } : undefined;
const card = postData?.card && /^\/[^?#]+\.(png|jpe?g)$/i.test(postData.card.src) && postData.card.alt ? postData.card : undefined;
const cardImage = shareFor(canonicalPath, route.title, { poster, card }).image;
const publisher = { '@type': 'Organization', name: site.legalName, url: `${site.url}/` };
if (path.startsWith('/blog/studying/')) {
  const note = studyNotes.find(entry => `/blog/studying/${entry.slug}` === path);
  if (note) jsonLd.push(graph({ '@type': 'Article', headline: note.title, description: route.description, datePublished: isoDate(note.date), author: personJsonLd(), publisher, mainEntityOfPage: `${site.url}${canonicalPath}`, isBasedOn: note.youtubeUrl || undefined },
    breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Signals & Systems', href: '/blog/' }, { name: note.title, href: canonicalPath }])));
} else if (path.startsWith('/blog/')) {
  const post = visibleBlogPosts.find(entry => `/blog/${entry.slug}` === path);
  if (post && post.status !== 'draft') jsonLd.push(graph({ '@type': 'Article', headline: post.title, description: (post as { metaDescription?: string }).metaDescription || post.teaser, datePublished: isoDate(post.date), author: personJsonLd(), publisher, mainEntityOfPage: `${site.url}${canonicalPath}` },
    breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Signals & Systems', href: '/blog/' }, { name: post.title, href: canonicalPath }])));
} else if (path.startsWith('/case-studies/')) {
  const study = caseStudies.find(entry => `/case-studies/${entry.slug}` === path);
  if (study) jsonLd.push(graph({ '@type': 'CreativeWork', name: study.title, description: study.thesis, url: `${site.url}${canonicalPath}`, author: personJsonLd(), publisher, image: route.image ? `${site.url}${route.image}` : cardImage },
    breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Work', href: '/work/' }, { name: study.title, href: canonicalPath }])));
}
---
<AgencyLayout path={canonicalPath} title={route.title} description={route.description} poster={poster} card={card} type={path.startsWith('/blog/') ? 'article' : 'website'} noindex={route.noindex} jsonLd={jsonLd} bodyClass="ag-parity">
  <ParityPage path={path} />
</AgencyLayout>
