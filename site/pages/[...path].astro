---
import ParityPage, { parityRoutes, parityMetadata } from '../components/ParityPage';
import '../../baseline/src/index.css';
import '../components/parity/parity.css';

export function getStaticPaths() {
  return parityRoutes.filter(route => !route.standalone).map(route => ({
    params: { path: route.path === '/' ? undefined : route.path.slice(1) },
    props: { path: route.path },
  }));
}
const { path } = Astro.props;
const route = parityMetadata(path)!;
const canonical = new URL(path === '/' ? '/' : `${path}/`, 'https://mitchjmiller.com').href;
const image = new URL(route.image!, 'https://mitchjmiller.com').href;
const release = process.env.SITE_BUILD_MODE === 'release';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{route.title}</title>
    <meta name="description" content={route.description} />
    <meta name="robots" content={release && !route.noindex ? 'index, follow' : 'noindex, nofollow, noarchive'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={route.title} />
    <meta property="og:description" content={route.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={path.startsWith('/blog/') ? 'article' : 'website'} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={route.title} />
    <meta name="twitter:description" content={route.description} />
    <meta name="twitter:image" content={image} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <noscript><style>[data-filter-card][hidden]{display:block!important}[data-filter-value]{display:none!important}</style></noscript>
  </head>
  <body>
    <ParityPage path={path} />
    <script>import '../components/parity/enhance';</script>
  </body>
</html>
