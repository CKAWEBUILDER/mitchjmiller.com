---
import CandidateLayout from '../../../layouts/CandidateLayout.astro';
import {caseStudies, studyEditorial, sfcEvidenceImages} from '../../../lib/content';
const entry = caseStudies.find(study => study.slug === 'sfc-surf-school')!;
const story = studyEditorial['sfc-surf-school'];
const explorerImage = sfcEvidenceImages[0];
const insightsImage = sfcEvidenceImages[1];
const chapterId = (index: number) => `chapter-${index + 1}`;
---
<CandidateLayout title="SFC Surf School — from local knowledge to a useful product" description={story.summary}>
  <section class="case-hero">
    <div class="candidate-wrap">
      <a class="back-link" href="/design/#selected-work"><span aria-hidden="true">←</span> Selected work</a>
      <div class="case-hero-grid"><div><p class="eyebrow">{story.client} · {story.category}</p><h1>{story.headline}</h1><p class="hero-deck">{story.summary}</p></div><dl class="case-metadata"><div><dt>My role</dt><dd>{entry.role}</dd></div><div><dt>Setting</dt><dd>{story.accent}</dd></div><div><dt>Period</dt><dd>{story.period}</dd></div><div><dt>Collaboration</dt><dd>{entry.partners}</dd></div></dl></div>
    </div>
  </section>
  <div class="candidate-wrap case-opening">
    <figure class="case-lead-image"><a href={explorerImage.src} aria-label="View the full-size SFC explorer screenshot"><img src={explorerImage.src} alt={explorerImage.alt} width="1440" height="1000" fetchpriority="high" /></a><figcaption><span>{explorerImage.caption}</span><a href={explorerImage.src}>View full size <span aria-hidden="true">↗</span></a></figcaption></figure>
    <section class="case-results" aria-labelledby="results-heading"><p class="eyebrow" id="results-heading">Progress, with the timeline intact</p><div class="results-grid">{story.metrics.map(metric => <div><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.note}</small></div>)}</div><p class="measurement-note">Search comparison: August 12–September 8 vs July 15–August 11, 2026. The explorer and ten guides shipped September 10, after the measurement period. These figures describe the earlier website and search work, not the explorer’s impact or booking growth.</p></section>
  </div>
  <div class="candidate-wrap case-body-grid">
    <aside class="case-contents"><nav aria-label="On this page"><p class="eyebrow">Inside the work</p><ol>{story.chapters.map((chapter, index) => <li><a href={`#${chapterId(index)}`}>{chapter.title}</a></li>)}</ol><a class="text-link" href="#evidence">Evidence &amp; deliverables <span aria-hidden="true">↓</span></a></nav></aside>
    <article class="case-story" aria-label="SFC Surf School case study">
      {story.chapters.map((chapter, index) => <section id={chapterId(index)} class="case-chapter">
        <p class="chapter-number">0{index + 1}</p><h2>{chapter.title}</h2>{chapter.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        {index === 1 && <div class="artifact-callout"><div><p class="eyebrow">Working deliverable</p><h3>Explore the South Shore.</h3><p>Ten named breaks, original video sources and connected guides on the surf school’s public website.</p></div>{story.links?.filter(link => link.external).map(link => <a class="candidate-button" href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>)}</div>}
        {index === 3 && <figure class="insights-figure"><a href={insightsImage.src} aria-label="View the full-size Search Console evidence"><img src={insightsImage.src} alt={insightsImage.alt} width="1035" height="751" loading="lazy" /></a><figcaption>{insightsImage.caption} <a href={insightsImage.src}>View full size <span aria-hidden="true">↗</span></a></figcaption></figure>}
      </section>)}
      <section class="case-takeaway" aria-labelledby="takeaway-heading"><p class="eyebrow">What the work demonstrates</p><h2 id="takeaway-heading">The strategy is in what ships.</h2><p>{story.takeaway}</p></section>
      <section id="evidence" class="case-evidence"><h2>Evidence &amp; deliverables</h2><p>{story.evidence}</p><ul>{story.links?.map(link => <li><a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.label} <span aria-hidden="true">↗</span></a></li>)}<li><a href="/artifacts/destination-intent-explorer.html" download>Download the standalone destination-intent explorer <span aria-hidden="true">↓</span></a><span>A separate interactive research artifact.</span></li></ul></section>
    </article>
  </div>
  <section class="candidate-cta"><div class="candidate-wrap case-cta-inner"><div><p class="eyebrow">Connect the research to the real work</p><h2>Have a problem worth working through?</h2></div><a class="candidate-button" href="/contact/">Let’s talk <span aria-hidden="true">↗</span></a></div></section>
</CandidateLayout>
