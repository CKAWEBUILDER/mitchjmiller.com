---
/**
 * /es/blog/ — Spanish index of Signals & Systems (site standards pilot, 2026-09-24): the
 * translated posts first, then the published English posts, marked as English. Study notes
 * stay on the English index. Route manifest: kind "added", lang "es", translationOf "/blog/".
 */
import AgencyLayout from '../../../layouts/AgencyLayout.astro';
import { esPosts } from '../../../i18n/es-posts';
import { publishedBlogPosts } from '../../../../baseline/src/lib/published';
import { site, breadcrumbJsonLd, graph } from '../../../lib/agency';
import { esDate } from '../../../lib/i18n';

const title = 'Artículos — Notas sobre búsqueda, crecimiento y búsqueda con IA';
const description = 'Notas de campo sobre búsqueda empresarial, medición de la búsqueda con IA y sistemas de crecimiento, a partir de proyectos reales.';
const translated = new Set(esPosts.map(post => post.slug));
const english = publishedBlogPosts.filter(post => !translated.has(post.slug));
const jsonLd = [graph(
  { '@type': 'CollectionPage', '@id': `${site.url}/es/blog/#webpage`, url: `${site.url}/es/blog/`, name: title, description, inLanguage: 'es' },
  breadcrumbJsonLd([{ name: 'Inicio', href: '/es/' }, { name: 'Signals & Systems', href: '/es/blog/' }]),
)];
---
<AgencyLayout path="/es/blog/" title={title} description={description} jsonLd={jsonLd} bodyClass="ag-parity">
  <div class="container mx-auto px-4 md:px-8 py-24 max-w-4xl">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">Signals &amp; Systems</h1>
    <p class="text-xl text-muted-foreground mb-14">Notas prácticas sobre SEO empresarial, AEO/GEO, búsqueda con IA y sistemas de crecimiento. Aquí están los artículos traducidos al español; el resto sigue en inglés.</p>

    <h2 class="text-2xl font-bold text-primary mb-8">En español</h2>
    <div class="space-y-12 mb-16">
      {esPosts.map(post => <div class="border-b border-border pb-12 last:border-0">
        <div class="mb-2 flex items-center gap-3"><span class="text-sm font-bold uppercase tracking-wider text-secondary">{post.date}</span></div>
        <a href={`/es/blog/${post.slug}/`}><h3 class="text-2xl md:text-3xl font-bold text-primary hover:text-secondary transition-colors cursor-pointer mb-3">{post.title}</h3></a>
        <p class="text-lg text-muted-foreground leading-relaxed mb-6">{post.teaser}</p>
        <a href={`/es/blog/${post.slug}/`} class="font-medium text-primary hover:text-secondary transition-colors">Leer el artículo →</a>
      </div>)}
    </div>

    <h2 class="text-2xl font-bold text-primary mb-3">Más artículos, en inglés</h2>
    <p class="text-muted-foreground mb-8">Estos artículos todavía no están traducidos. Las notas de estudio están en el <a class="text-secondary hover:underline" href="/blog/" hreflang="en">índice en inglés</a>.</p>
    <div class="space-y-12">
      {english.map(post => <div class="border-b border-border pb-12 last:border-0">
        <div class="mb-2 flex items-center gap-3"><span class="text-sm font-bold uppercase tracking-wider text-secondary">{esDate(post.date)} · en inglés</span></div>
        <a href={`/blog/${post.slug}/`} hreflang="en"><h3 lang="en" class="text-2xl md:text-3xl font-bold text-primary hover:text-secondary transition-colors cursor-pointer mb-3">{post.title}</h3></a>
        <p lang="en" class="text-lg text-muted-foreground leading-relaxed mb-6">{post.teaser}</p>
        <a href={`/blog/${post.slug}/`} hreflang="en" class="font-medium text-primary hover:text-secondary transition-colors">Leer en inglés →</a>
      </div>)}
    </div>
  </div>
</AgencyLayout>
