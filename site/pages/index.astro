---
/**
 * Home — agency positioning (2026-09-14). Structure follows the Contiem reference:
 * hero, lifecycle strip, brand marquee, objectives grid, service cards, industries,
 * selected work (secondary), lab and writing teasers, CTA band. Every figure comes
 * from the existing approved case-study data; nothing here invents staff, clients
 * counts, prices or results.
 */
import AgencyLayout from '../layouts/AgencyLayout.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import M2Mark from '../components/M2Mark.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { caseStudies, portfolioImages, studyEditorial, sfcEvidenceImages } from '../lib/content';
import { publishedBlogPosts } from '../../baseline/src/lib/published';
import { site, organizationJsonLd, personJsonLd, graph } from '../lib/agency';

const title = 'Mitchell Miller — Digital Growth, Software & Consulting';
const description = 'Research, digital strategy, experience design and engineering. Work with Mitchell Miller to turn complex questions into practical growth.';
const hero = sfcEvidenceImages[0];

const stages = [
  {
    "id": "understand",
    "name": "Understand",
    "line": "Find the opportunity.",
    "icon": "research"
  },
  {
    "id": "design",
    "name": "Design",
    "line": "Make the next step clear.",
    "icon": "design"
  },
  {
    "id": "build",
    "name": "Build",
    "line": "Connect the pieces.",
    "icon": "engineering"
  },
  {
    "id": "grow",
    "name": "Grow",
    "line": "Learn. Refine. Grow.",
    "icon": "growth"
  }
];
const objectives = [
  {
    "title": "Find the opportunity.",
    "body": "Research turns market signals into a direction worth pursuing.",
    "href": "/services/#understand",
    "icon": "research",
    "keyword": "Research"
  },
  {
    "title": "Make it feel simple.",
    "body": "Experience design connects what people need with what you make possible.",
    "href": "/services/#design",
    "icon": "design",
    "keyword": "Experience design"
  },
  {
    "title": "Make more possible.",
    "body": "Engineering brings useful ideas to life, with room to evolve.",
    "href": "/services/#build",
    "icon": "engineering",
    "keyword": "Engineering"
  },
  {
    "title": "Know what works.",
    "body": "Measurement makes the next decision clearer than the last.",
    "href": "/services/#grow",
    "icon": "measurement",
    "keyword": "Measurement"
  }
];
const services = [
  {
    "title": "Research & analysis",
    "body": "Research reveals demand, competition and the questions your data can answer.",
    "href": "/services/#understand",
    "icon": "research",
    "keyword": "Research"
  },
  {
    "title": "Digital strategy",
    "body": "Digital strategy connects immediate priorities to a stronger long-term position.",
    "href": "/services/#understand",
    "icon": "strategy",
    "keyword": "Digital strategy"
  },
  {
    "title": "Experience design",
    "body": "Experience design gives content, interfaces and customer journeys a clear purpose.",
    "href": "/services/#design",
    "icon": "design",
    "keyword": "Experience design"
  },
  {
    "title": "Engineering",
    "body": "Engineering connects websites, applications, databases and content systems built to last.",
    "href": "/services/#build",
    "icon": "engineering",
    "keyword": "Engineering"
  },
  {
    "title": "Search & growth",
    "body": "SEO brings relevant demand closer. AEO and conversion testing help turn attention into opportunity.",
    "href": "/services/#grow",
    "icon": "growth",
    "keyword": "SEO"
  },
  {
    "title": "AI workflows",
    "body": "AI workflows put useful automation around the work, with human judgment where it matters.",
    "href": "/services/#build",
    "icon": "automation",
    "keyword": "AI workflows"
  }
];
// Industries adopted from the copy pack §(e): five sectors with published evidence; links go to the supporting case studies.
const industries = [
  { name: 'Healthcare', body: 'Healthcare experiences that help people find the right care.', links: [{ label: 'Location conversion engine', href: '/case-studies/commonspirit-locations-conversion-engine/' }, { label: 'Stanford MyHealth', href: '/case-studies/stanford-myhealth-seo/' }, { label: 'AEM architecture', href: '/case-studies/aem-content-fragmentation-architecture/' }] },
  { name: 'Global commerce & tech', body: 'Commerce programs connecting global reach with local intent.', links: [{ label: 'Apple seasonal search', href: '/case-studies/apple-seasonal-search/' }, { label: 'Apple Store AMR', href: '/case-studies/apple-store-amr/' }, { label: 'Apple Education Store', href: '/case-studies/apple-education-store/' }] },
  { name: 'AI & software', body: 'Software that makes research, reporting and decisions more useful.', links: [{ label: 'ClarityPulse', href: '/case-studies/claritypulse-ai-reporting/' }, { label: 'AEO visibility infrastructure', href: '/case-studies/aeo-visibility-infrastructure/' }, { label: 'SearchForge', href: '/case-studies/searchforge-content-intelligence/' }] },
  { name: 'Travel, recreation & local services', body: 'Local discovery that leads to real-world experiences.', links: [{ label: 'SFC Surf School', href: '/case-studies/sfc-surf-school/' }] },
  { name: 'Nonprofit', body: 'Nonprofit outreach that turns awareness into participation.', links: [{ label: 'Vet Advocates growth system', href: '/case-studies/vet-advocates-growth-system/' }] },
];
const selected = [
  { slug: 'commonspirit-locations-conversion-engine', image: portfolioImages['commonspirit-locations-conversion-engine'] },
  { slug: 'apple-seasonal-search', image: portfolioImages['apple-seasonal-search'] },
  { slug: 'sfc-surf-school', image: { src: hero.src, alt: hero.alt, note: 'Production release review, September 10, 2026.' } },
  { slug: 'claritypulse-ai-reporting', image: portfolioImages['claritypulse-ai-reporting'] },
].map(item => ({ ...item, entry: caseStudies.find(study => study.slug === item.slug)!, story: studyEditorial[item.slug] }));
const posts = publishedBlogPosts.slice(0, 3);
const jsonLd = [graph(organizationJsonLd(), personJsonLd(), { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': `${site.url}/#organization` } })];
---
<AgencyLayout path="/" title={title} description={description} jsonLd={jsonLd} bodyClass="ag-home">
  <section class="ag-hero ag-dark" aria-labelledby="home-heading">
    <div class="ag-wrap ag-hero-grid">
      <div class="ag-hero-copy">
        <p class="ag-eyebrow">Research · Strategy · Design · Engineering</p>
        <h1 id="home-heading">Make the next<br />move matter.</h1>
        <p class="ag-hero-deck">Turn complex questions into clear direction, useful experiences and systems built for growth.</p>
        <div class="ag-hero-actions"><a class="ag-button" href="/contact/">Start a conversation</a></div>
      </div>
    </div>
  </section>

  <BrandMarquee id="home-brands" />

  <section class="ag-lifecycle" aria-label="How the work fits together">
    <div class="ag-wrap">
      <p class="ag-lifecycle-label">Strategy through delivery</p>
      <ol>{stages.map(stage => <li><a href={`/services/#${stage.id}`}><ServiceIcon name={stage.icon} label={stage.name} decorative /><strong>{stage.name}</strong><span>{stage.line}</span></a></li>)}</ol>
    </div>
  </section>

  <section class="ag-section" aria-labelledby="objectives-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">Objectives</p><h2 id="objectives-heading">What could come next?</h2><p>A sharper question can open a different path.</p></div><a class="ag-textlink" href="/services/">All services <span aria-hidden="true">→</span></a></div>
      <div class="ag-grid-4">{objectives.map(item => <a class="ag-tile" href={item.href}><ServiceIcon name={item.icon} label={item.keyword} /><h3>{item.title}</h3><p>{item.body}</p><span class="ag-textlink">How we help <span aria-hidden="true">→</span></span></a>)}</div>
    </div>
  </section>

  <section class="ag-section ag-section--tint" aria-labelledby="services-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">Services</p><h2 id="services-heading">Clear thinking. Useful work.</h2><p>One challenge or the whole journey. Bring the right disciplines together.</p></div><a class="ag-textlink" href="/services/">Service details <span aria-hidden="true">→</span></a></div>
      <div class="ag-grid-3">{services.map(item => <a class="ag-tile" href={item.href}><ServiceIcon name={item.icon} label={item.keyword} /><h3>{item.title}</h3><p>{item.body}</p><span class="ag-textlink">Read more <span aria-hidden="true">→</span></span></a>)}</div>
    </div>
  </section>

  <section class="ag-section ag-products-section" aria-labelledby="products-heading"><div class="ag-wrap"><div class="ag-section-head"><div><p class="ag-eyebrow">Software &amp; tools</p><h2 id="products-heading">Put better tools to work.</h2><p>Explore a working tool. Follow an idea taking shape.</p></div><a class="ag-textlink" href="/products/">All products <span aria-hidden="true">→</span></a></div><ProductGrid featured /></div></section>

  <section class="ag-section" aria-labelledby="industries-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">Industries</p><h2 id="industries-heading">Different worlds. Connected thinking.</h2><p>From global systems to the businesses next door.</p></div></div>
      <div class="ag-grid-3">{industries.map(item => <div class="ag-tile ag-industry"><h3>{item.name}</h3><p>{item.body}</p><p>{item.links.map((link, index) => <>{index > 0 && ' · '}<a href={link.href}>{link.label}</a></>)}</p></div>)}</div>
    </div>
  </section>

  <section class="ag-section ag-section--tint" aria-labelledby="work-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">Selected work</p><h2 id="work-heading">The work makes it tangible.</h2><p>A closer look at the questions, decisions and outcomes.</p></div><a class="ag-textlink" href="/work/">All case studies <span aria-hidden="true">→</span></a></div>
      <div class="ag-grid-2">{selected.map(({ slug, entry, story, image }) => <article class="ag-work-card">
        <figure><a class="ag-work-image" href={`/case-studies/${slug}/`} aria-label={`Read ${entry.title}`}><img src={image.src} alt={image.alt} loading="lazy" width="1400" height="900" class:list={{ contain: (image as { fit?: string }).fit === 'contain' }} /></a>{image.note && <figcaption>{image.note}</figcaption>}</figure>
        <div class="ag-work-body"><p class="ag-eyebrow">{story.client} · {story.category}</p><h3><a href={`/case-studies/${slug}/`}>{story.headline}</a></h3><p>{({
  "commonspirit-locations-conversion-engine": "A clearer path from finding care to taking action.",
  "apple-seasonal-search": "Search planning for the moments customers care about.",
  "sfc-surf-school": "Local insight, useful experiences and a path to the water.",
  "claritypulse-ai-reporting": "An internal reporting prototype that keeps evidence close to the answer."
} as Record<string, string>)[slug]}</p>
          <div class="ag-work-foot">{story.metrics[0] ? <span><strong>{story.metrics[0].value}</strong><small>{story.metrics[0].label}{story.metrics[0].note ? ` · ${story.metrics[0].note}` : ''}</small></span> : <span><small>{story.period}</small></span>}<a class="ag-textlink" href={`/case-studies/${slug}/`}>Read the case <span aria-hidden="true">→</span></a></div>
        </div>
      </article>)}</div>
    </div>
  </section>

  <section class="ag-section" aria-labelledby="lab-heading">
    <div class="ag-wrap ag-split">
      <div><p class="ag-eyebrow">Lab</p><h2 id="lab-heading">Follow your curiosity.</h2><p>The learning lab turns data into something you can explore. Change an assumption. Compare a scenario. See what changes.</p><a class="ag-button" href="/lab/">Explore the learning lab</a></div>
      <div class="ag-panel"><h3>Also in the lab</h3><ul><li><a href="/lab/#intent">Destination intent explorer</a> — what a destination-qualified query tells you.</li><li><a href="/lab/#evidence">The story behind a growth number</a> — how the baseline changes the interpretation.</li><li><a href="/lab/#architecture">One field, connected experiences</a> — reuse and local overrides in content systems.</li><li><a href="/lab/population-workbench/methodology/">Workbench methodology and limitations</a></li></ul></div>
    </div>
  </section>

  <section class="ag-section ag-section--tint" aria-labelledby="writing-heading">
    <div class="ag-wrap ag-split">
      <div><p class="ag-eyebrow">Writing</p><h2 id="writing-heading">Signals &amp; Systems.</h2><p>Ideas about search, technology and the decisions between them.</p><a class="ag-textlink" href="/blog/">Explore insights <span aria-hidden="true">→</span></a></div>
      <ul class="ag-posts">{posts.map(post => <li><span class="ag-post-date">{post.date}</span><h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3></li>)}</ul>
    </div>
  </section>

  <section class="ag-section" aria-labelledby="principal-heading">
    <div class="ag-wrap ag-split">
      <div><p class="ag-eyebrow">About</p><h2 id="principal-heading">A thinking partner. A hands-on builder.</h2><p>Work directly with Mitchell Miller—from the first question to the details that make it work.</p><a class="ag-textlink" href="/about/">About Mitchell <span aria-hidden="true">→</span></a></div>
      <div class="ag-principal"><M2Mark size={88} /><div><strong>Mitchell Miller</strong><p>Digital strategy, research &amp; engineering · <a href={site.personalPortfolio}>Personal work history and resume</a> · <a href={site.linkedin}>LinkedIn</a>.</p></div></div>
    </div>
  </section>

  <section class="ag-cta ag-dark" aria-labelledby="cta-heading">
    <div class="ag-wrap ag-cta-inner">
      <div><p class="ag-eyebrow">Ready to explore further?</p><h2 id="cta-heading">What are you imagining?</h2><p>Bring the question. We’ll work out the next move together.</p></div>
      <div class="ag-cta-actions"><a class="ag-button" href="/contact/">Start a conversation</a></div>
    </div>
  </section>
</AgencyLayout>
