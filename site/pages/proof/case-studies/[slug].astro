---
import ProofLayout from '../../../layouts/ProofLayout.astro';
import {caseStudies} from '../../../../src/lib/data';
import {studyEditorial, portfolioImages, sfcEvidenceImages} from '../../../lib/content';
export function getStaticPaths(){return ['apple-seasonal-search','sfc-surf-school'].map(slug=>({params:{slug},props:{entry:caseStudies.find(c=>c.slug===slug)!,story:studyEditorial[slug]}}));}
const {entry,story}=Astro.props;
---
<ProofLayout title={entry.title} description={story.summary} canonical={`https://mitchjmiller.com/case-studies/${entry.slug}/`}><p>{story.client} · {story.period}</p><h1>{story.headline}</h1><p class="deck">{story.summary}</p><p><strong>Role:</strong> {entry.role}</p>{story.metrics?.length>0&&<div class="facts">{story.metrics.map(metric=><div><strong>{metric.value}</strong><span>{metric.label}</span><small>{metric.note}</small></div>)}</div>}{portfolioImages[entry.slug]&&<figure><img src={portfolioImages[entry.slug].src} alt={portfolioImages[entry.slug].alt} style="width:100%;height:auto"/><figcaption>{portfolioImages[entry.slug].note}</figcaption></figure>}{entry.slug==='sfc-surf-school'&&sfcEvidenceImages.map(image=><figure><img src={image.src} alt={image.alt} style="width:100%;height:auto"/><figcaption>{image.caption}</figcaption></figure>)}<article class="body">{story.chapters.map(chapter=><section><h2>{chapter.title}</h2>{chapter.paragraphs.map(paragraph=><p>{paragraph}</p>)}</section>)}<h2>What this work demonstrates</h2><p>{story.takeaway}</p><h2>Evidence and context</h2><p>{story.evidence}</p>{story.links?.filter(link=>link.external).map(link=><p><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></p>)}</article><p><a href="/proof/">Back to all content proofs</a></p></ProofLayout>
