---
import palettes from '../../data/palette-options.json';
interface LogoOption { id: string; name: string; description: string; src?: string; preview?: string; download?: string; width?: number; height?: number; }
const manifests = import.meta.glob('../../data/m2-options.json', { eager: true, import: 'default' });
const rawLogos = Object.values(manifests)[0] as LogoOption[] | { options: LogoOption[] } | undefined;
const logos: LogoOption[] = Array.isArray(rawLogos) ? rawLogos : rawLogos?.options ?? [];
const first = palettes[0];
const colorStyle = (p: typeof first) => `--p-ink:${p.ink};--p-paper:${p.paper};--p-surface:${p.surface};--p-accent:${p.accent};--p-muted:${p.muted}`;
const swatches = ['ink', 'paper', 'surface', 'accent', 'muted'] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex, follow" />
    <meta name="description" content="Five solid-color palettes and ten M² logo concepts for Mitchell Miller’s design review." />
    <title>Color &amp; M² logo options · Mitchell Miller</title>
    <link rel="icon" href="/favicon.svg" />
    <style is:inline>
      *{box-sizing:border-box}html{font-family:Arial,Helvetica,sans-serif;color:#24282d;background:#f8f9fa;font-synthesis:none}body{margin:0;font-size:16px;line-height:1.6}a{color:inherit;text-underline-offset:4px}button,input{font:inherit}a:focus-visible,button:focus-visible{outline:3px solid #24282d;outline-offset:5px}.skip{position:absolute;left:16px;top:-100px;z-index:2;background:#fff;padding:10px}.skip:focus{top:10px}.wrap{width:min(1240px,calc(100% - 64px));margin-inline:auto}.review-header{background:#fff;border-bottom:1px solid #dce0e3}.header-inner{min-height:88px;display:flex;justify-content:space-between;align-items:center;gap:24px}.brand{font-size:17px;font-weight:700;text-decoration:none;letter-spacing:-.025em}.brand span{display:block;font-size:11px;font-weight:400;letter-spacing:.13em;text-transform:uppercase;color:#606870}.review-nav{display:flex;flex-wrap:wrap;gap:26px;font-size:14px}.review-nav a{text-decoration:none}.review-nav a:hover{text-decoration:underline}.intro{text-align:center;padding:75px 0 55px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;font-weight:700;color:#606870;margin:0 0 15px}h1{font-size:clamp(34px,4.5vw,58px);font-weight:500;letter-spacing:-.045em;line-height:1.12;margin:0 0 22px}h2{font-size:clamp(27px,3vw,36px);font-weight:500;letter-spacing:-.035em;line-height:1.2;margin:0}h3{line-height:1.25}p{margin:0}.intro>p:last-child{color:#606870;max-width:660px;margin:auto;font-size:17px}.review-section{padding:28px 0 60px;scroll-margin-top:24px}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:30px;margin-bottom:25px}.section-heading>div>p{font-size:14px;margin-top:10px;color:#606870}.section-number{font-size:12px;letter-spacing:.12em;margin-bottom:12px;color:#606870}.selection-note{font-size:13px;color:#606870;max-width:295px}.palette-fieldset{border:0;padding:0;margin:0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.palette-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:14px}.palette-choice{position:relative;display:block;min-width:0}.palette-radio{position:absolute;top:16px;left:16px;width:17px;height:17px;margin:0;accent-color:#24282d;z-index:1}.palette-card{display:block;border:1px solid #cfd4d9;background:#fff;cursor:pointer;height:100%;padding:15px;border-radius:3px;outline:2px solid transparent;outline-offset:2px}.palette-radio:checked+.palette-card{border-color:#24282d;outline-color:#24282d}.palette-radio:focus-visible+.palette-card{outline:3px solid #477B8E;outline-offset:4px}.palette-title{display:block;font-size:13px;font-weight:700;padding-left:27px;line-height:20px;min-height:40px;margin-bottom:14px}.palette-title small{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.08em;font-weight:400;color:#606870}.mini-site{display:block;background:var(--p-paper);border:1px solid #dce0e3;color:var(--p-ink)}.mini-header{display:flex;justify-content:space-between;align-items:center;padding:10px;font-size:9px;font-weight:700}.mini-nav{display:flex;gap:4px}.mini-nav i{display:block;width:13px;height:2px;background:var(--p-muted)}.mini-hero{display:flex;flex-direction:column;align-items:center;text-align:center;justify-content:center;padding:17px 7px;background:var(--p-ink);min-height:105px;color:var(--p-paper)}.mini-title{font-size:14px;font-weight:700;line-height:1.2;max-width:140px}.mini-button{display:block;background:var(--p-accent);color:#fff;padding:5px 8px;margin-top:12px;font-size:8px;font-weight:700}.mini-strip{height:15px;background:var(--p-surface)}.swatches{display:grid;grid-template-columns:repeat(5,1fr);height:27px;gap:3px;margin-top:13px}.swatch{border:1px solid #dce0e3}.palette-character{display:block;margin-top:12px;font-size:12px;color:#606870;line-height:1.5}.preview-heading{margin-top:36px;display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:12px;font-size:13px;color:#606870}.preview-heading strong{color:#24282d}.specimen{border:1px solid #cfd4d9;background:var(--p-paper);color:var(--p-ink);overflow:hidden}.specimen-header{display:flex;justify-content:space-between;align-items:center;padding:23px 36px;gap:20px}.specimen-wordmark{font-size:18px;letter-spacing:-.04em;font-weight:700}.specimen-nav{display:flex;gap:25px;font-size:12px;font-weight:700;color:var(--p-muted)}.specimen-hero{text-align:center;background:var(--p-ink);color:var(--p-paper);padding:60px 28px 57px}.specimen-eyebrow{font-size:10px;letter-spacing:.17em;text-transform:uppercase;margin-bottom:17px}.specimen-hero h3{font-size:clamp(30px,4vw,48px);letter-spacing:-.045em;font-weight:500;margin:0 auto 19px;line-height:1.13;max-width:700px}.specimen-hero p:not(.specimen-eyebrow){max-width:590px;margin:0 auto 26px;font-size:15px}.specimen-button{display:inline-flex;background:var(--p-accent);color:#fff;border:0;border-radius:3px;padding:13px 25px;font-size:13px;font-weight:700}.specimen-services{padding:34px 36px;background:var(--p-surface);display:grid;grid-template-columns:repeat(3,1fr);gap:30px}.specimen-service svg{display:block;width:26px;height:26px;fill:var(--p-accent);margin-bottom:13px}.specimen-service h4{margin:0 0 9px;font-size:15px}.specimen-service p{font-size:13px;color:var(--p-muted);max-width:270px}.color-reference{margin-top:18px;border:1px solid #dce0e3;background:#fff;border-radius:3px}.color-reference summary{padding:15px 18px;cursor:pointer;font-size:13px;font-weight:700}.color-reference summary:focus-visible{outline:3px solid #477B8E;outline-offset:3px}.reference-content{padding:0 18px 20px}.reference-content>p{font-size:12px;color:#606870;margin-bottom:16px}.color-values{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;margin:0 0 20px}.color-values dt{text-transform:capitalize;color:#606870;font-size:11px}.color-values dd{margin:4px 0 0;font-size:12px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.contrast-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.contrast-grid>p{padding:12px;background:#f8f9fa;font-size:12px}.contrast-grid strong{display:block;font-size:17px;font-weight:500}.reference-footnote{margin-top:13px!important;margin-bottom:0!important;font-size:11px!important}.logo-section{border-top:1px solid #dce0e3;padding-top:55px}.logo-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:23px}.logo-card{margin:0;background:#fff;border:1px solid #dce0e3;border-radius:3px;overflow:hidden}.logo-stage{display:flex;align-items:center;justify-content:center;aspect-ratio:1;background:#fff;overflow:hidden}.logo-stage img{display:block;width:100%;height:100%;object-fit:contain}.logo-info{padding:20px;border-top:1px solid #e8eaed}.logo-info h3{font-size:18px;font-weight:500;margin:0 0 10px;letter-spacing:-.025em}.logo-number{font-size:11px;color:#606870;letter-spacing:.06em;margin-right:7px}.logo-info>p{color:#606870;font-size:13px;min-height:42px}.logo-actions{display:flex;flex-wrap:wrap;gap:12px 18px;align-items:center;margin-top:18px;font-size:12px}.logo-actions a{font-weight:700;min-height:24px;display:inline-flex;align-items:center}.logo-dimensions{font-size:10px;color:#606870}.waiting{padding:30px;border:1px solid #dce0e3;background:#fff;color:#606870}.review-footer{border-top:1px solid #dce0e3;padding:27px 0 35px;font-size:12px;color:#606870;display:flex;justify-content:space-between;gap:20px}.nojs{display:block;margin-top:16px;font-size:13px;color:#606870}
      @media(min-width:1100px){.logo-grid{grid-template-columns:repeat(5,minmax(0,1fr));gap:17px}.logo-info{padding:17px}.logo-info h3{font-size:16px}.logo-info>p{min-height:78px}.logo-actions{display:block}.logo-actions a{display:flex;margin-top:7px}.logo-dimensions{display:block;margin-top:9px}}
      @media(max-width:1000px){.palette-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.palette-title{min-height:20px}.mini-hero{min-height:115px}.mini-title{font-size:16px}.palette-choice:nth-child(4),.palette-choice:nth-child(5){grid-column:auto}.specimen-services{gap:22px}.logo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
      @media(max-width:640px){.wrap{width:calc(100% - 36px)}.header-inner{min-height:86px;gap:15px}.review-nav{gap:13px;font-size:12px}.review-nav a:first-child{display:none}.intro{padding:48px 0 30px}.intro>p:last-child{font-size:15px}.section-heading{display:block}.selection-note{margin-top:15px;max-width:none}.palette-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.palette-card{padding:12px}.palette-radio{left:13px;top:13px}.palette-title{font-size:12px;min-height:40px}.palette-character{font-size:11px}.mini-title{font-size:13px}.mini-hero{min-height:105px}.specimen-header{padding:20px}.specimen-wordmark{font-size:16px}.specimen-nav{gap:12px;font-size:10px}.specimen-nav span:last-child{display:none}.specimen-hero{padding:43px 22px}.specimen-hero p:not(.specimen-eyebrow){font-size:14px}.specimen-services{grid-template-columns:1fr;padding:26px;gap:25px}.specimen-service{display:grid;grid-template-columns:26px 1fr;column-gap:16px}.specimen-service svg{grid-row:span 2;margin:0}.specimen-service h4{margin-bottom:5px}.specimen-service p{max-width:none}.color-values{grid-template-columns:repeat(3,1fr)}.contrast-grid{grid-template-columns:1fr}.preview-heading{font-size:11px;align-items:flex-start}.preview-heading span:last-child{max-width:145px;text-align:right}.logo-grid{gap:14px}.logo-info{padding:14px}.logo-info h3{font-size:15px}.logo-info>p{font-size:12px;min-height:72px}.logo-actions{display:block;font-size:11px}.logo-actions a{display:flex;margin-top:7px}.logo-dimensions{display:block;margin-top:9px}.review-footer{display:block}.review-footer a{display:inline-block;margin-top:12px}}
      @media(max-width:360px){.palette-grid,.logo-grid{grid-template-columns:1fr}.palette-title{min-height:20px}.logo-info>p{min-height:0}.review-nav{gap:9px}}
    </style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to options</a>
    <header class="review-header">
      <div class="wrap header-inner">
        <a class="brand" href="/">Mitchell Miller<span>Design review</span></a>
        <nav class="review-nav" aria-label="Review navigation"><a href="/">Website</a><a href="#palettes">Palettes</a><a href="#logos">M² logos</a></nav>
      </div>
    </header>
    <main id="main" class="wrap">
      <div class="intro">
        <p class="eyebrow">Color &amp; identity</p>
        <h1>Simple. Solid. Distinct.</h1>
        <p>Five color directions and ten M² logo studies. Compare the palettes in context, then choose the mark that feels right.</p>
      </div>
      <section id="palettes" class="review-section" aria-labelledby="palette-title">
        <div class="section-heading">
          <div><p class="section-number">01 / COLOR</p><h2 id="palette-title">Five restrained palettes.</h2><p>Select a palette to see it on the sample below.</p></div>
          <p class="selection-note">The first option uses the current navy and green. Your preview choice stays on this page.</p>
        </div>
        <fieldset class="palette-fieldset">
          <legend class="sr-only">Choose a color palette for the sample website</legend>
          <div class="palette-grid">
            {palettes.map((palette, index) => (
              <label class="palette-choice" style={colorStyle(palette)}>
                <input class="palette-radio" type="radio" name="palette" value={palette.id} checked={index === 0} data-palette={JSON.stringify(palette)} aria-describedby={`palette-description-${palette.id}`} />
                <span class="palette-card">
                  <span class="palette-title">{palette.name}<small>Option {index + 1}</small></span>
                  <span class="mini-site" aria-hidden="true">
                    <span class="mini-header">Mitchell Miller<span class="mini-nav"><i></i><i></i><i></i></span></span>
                    <span class="mini-hero"><span class="mini-title">Clear thinking.<br />Useful outcomes.</span><span class="mini-button">Start a conversation</span></span>
                    <span class="mini-strip"></span>
                  </span>
                  <span class="swatches" aria-hidden="true">{swatches.map(key => <span class="swatch" style={`background:${palette[key]}`} title={`${key}: ${palette[key]}`}></span>)}</span>
                  <span id={`palette-description-${palette.id}`} class="palette-character">{palette.character}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>
        <noscript><p class="nojs">All five palettes are shown above. Enable JavaScript to change the larger sample.</p></noscript>
        <div class="preview-heading"><span aria-live="polite" aria-atomic="true">Previewing <strong id="selected-palette-name">{first.name}</strong></span><span>Same layout. Only the colors change.</span></div>
        <div id="palette-specimen" class="specimen" style={colorStyle(first)} role="region" aria-label="Sample website with the selected palette">
          <div class="specimen-header"><span class="specimen-wordmark">Mitchell Miller</span><div class="specimen-nav" aria-hidden="true"><span>Services</span><span>Products</span><span>Work</span><span>About</span></div></div>
          <div class="specimen-hero">
            <p class="specimen-eyebrow">Strategy · Design · Technology</p>
            <h3>Clear thinking.<br />Useful outcomes.</h3>
            <p>From the first question to the working solution. Strategy, websites and software built around what your business needs next.</p>
            <span class="specimen-button">Start a conversation</span>
          </div>
          <div class="specimen-services">
            <div class="specimen-service"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3h18v4H3zm0 7h11v4H3zm0 7h16v4H3z" /></svg><h4>Make the direction clear.</h4><p>Turn a complex business question into a practical plan.</p></div>
            <div class="specimen-service"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 3h20v18H2zm3 3v3h14V6zm0 6v6h5v-6zm8 0v6h6v-6z" fill-rule="evenodd" /></svg><h4>Build something useful.</h4><p>Websites and software that help people get things done.</p></div>
            <div class="specimen-service"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 14h4v7H3zm7-5h4v12h-4zm7-6h4v18h-4z" /></svg><h4>Keep improving.</h4><p>Use evidence to understand what works and what comes next.</p></div>
          </div>
        </div>
        <details class="color-reference">
          <summary>Color values &amp; contrast checks</summary>
          <div class="reference-content">
            <p id="palette-description">{first.description}</p>
            <dl class="color-values">{swatches.map(key => <div><dt>{key}</dt><dd data-color-value={key}>{first[key]}</dd></div>)}</dl>
            <div class="contrast-grid">
              <p><strong><span data-contrast="inkOnPaper">{first.contrast.inkOnPaper.toFixed(2)}</span>:1</strong>Primary text on paper · AA ≥ 4.5:1</p>
              <p><strong><span data-contrast="whiteOnAccent">{first.contrast.whiteOnAccent.toFixed(2)}</span>:1</strong>White text on the button · AA ≥ 4.5:1</p>
              <p><strong><span data-contrast="mutedOnSurface">{first.contrast.mutedOnSurface.toFixed(2)}</span>:1</strong>Secondary text on surface · AA ≥ 4.5:1</p>
            </div>
            <p class="reference-footnote">Accent against the dark hero: <span data-contrast="accentAgainstInk">{first.contrast.accentAgainstInk.toFixed(2)}</span>:1 (≥ 3:1). Values use the WCAG relative-luminance formula for these solid color pairs.</p>
          </div>
        </details>
      </section>
      <section id="logos" class="review-section logo-section" aria-labelledby="logo-title">
        <div class="section-heading">
          <div><p class="section-number">02 / IDENTITY</p><h2 id="logo-title">Ten ways to make M².</h2><p>Explore each mark at full size. Download the original PNG to keep a favorite.</p></div>
          <p class="selection-note">Logo studies are shown on white for comparison. The current website identity remains in place.</p>
        </div>
        {logos.length > 0 ? <div class="logo-grid">{logos.map((logo, index) => {
          const preview = logo.preview ?? logo.src;
          const download = logo.download ?? logo.src ?? preview;
          return <figure class="logo-card">
            <a class="logo-stage" href={download} aria-label={`Open option ${index + 1}, ${logo.name}, at full size`}><img src={preview} alt={`M² logo concept: ${logo.name}. ${logo.description}`} width={logo.width ?? 1280} height={logo.height ?? 1280} loading="lazy" decoding="async" /></a>
            <figcaption class="logo-info"><h3><span class="logo-number">{String(index + 1).padStart(2, '0')}</span>{logo.name}</h3><p>{logo.description}</p><div class="logo-actions"><a href={download} download={`m2-${String(index + 1).padStart(2, '0')}-${logo.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}.png`}>Download PNG</a><a href={download}>Full size <span aria-hidden="true">↗</span></a><span class="logo-dimensions">{logo.width ?? 1280} × {logo.height ?? 1280} px</span></div></figcaption>
          </figure>;
        })}</div> : <p class="waiting">M² logo images are being added to this review.</p>}
      </section>
    </main>
    <footer class="wrap review-footer"><p>Choose a palette and a logo by number or name. These are review options; selecting a palette only changes the sample.</p><a href="/">Back to the website</a></footer>
    <script is:inline>
      (() => {
        const specimen = document.getElementById('palette-specimen');
        const title = document.getElementById('selected-palette-name');
        const description = document.getElementById('palette-description');
        if (!specimen || !title || !description) return;
        document.querySelectorAll('input[data-palette]').forEach(input => {
          input.addEventListener('change', () => {
            if (!input.checked) return;
            const palette = JSON.parse(input.dataset.palette);
            ['ink', 'paper', 'surface', 'accent', 'muted'].forEach(key => {
              specimen.style.setProperty('--p-' + key, palette[key]);
              document.querySelector('[data-color-value="' + key + '"]').textContent = palette[key];
            });
            title.textContent = palette.name;
            description.textContent = palette.description;
            document.querySelectorAll('[data-contrast]').forEach(node => {
              node.textContent = palette.contrast[node.dataset.contrast].toFixed(2);
            });
          });
        });
      })();
    </script>
  </body>
</html>
