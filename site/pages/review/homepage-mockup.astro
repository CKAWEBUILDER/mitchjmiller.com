---
import brands from '../../data/brands.json';
import {products} from '../../data/products';
import {caseStudies, headshot} from '../../lib/content';
import {publishedBlogPosts} from '../../../baseline/src/lib/published';
import ServiceIcon from '../../components/ServiceIcon.astro';
const logos = brands.brands.filter(b => b.logo);
const stages = [
 {name:'Understand',icon:'research',copy:'Research, measurement and a clearer view of the opportunity.',href:'/services/#understand'},
 {name:'Design',icon:'design',copy:'Content and experiences that make the next step feel simple.',href:'/services/#design'},
 {name:'Build',icon:'engineering',copy:'Connected websites, applications and workflows built for use.',href:'/services/#build'},
 {name:'Grow',icon:'growth',copy:'Search, conversion and continuous learning, working together.',href:'/services/#grow'},
];
const help = [
 {name:'Find a clearer direction',icon:'research',copy:'Connect market signals, customer needs and performance data to the decisions ahead.',link:'Explore research & strategy',href:'/services/#understand'},
 {name:'Build something useful',icon:'engineering',copy:'Bring a website, content system or workflow from an idea into something people can use.',link:'Explore design & engineering',href:'/services/#build'},
 {name:'Grow the opportunity',icon:'growth',copy:'Make discovery, experience and conversion part of the same growth strategy.',link:'Explore search & growth',href:'/services/#grow'},
 {name:'Work together',icon:'strategy',copy:'Bring a question, a role or a project. Start with a conversation about what matters.',link:'Start a conversation',href:'/contact/'},
];
const industries = [
 {name:'Healthcare',icon:'measurement',copy:'Search, content and location experiences across enterprise and academic health systems.',href:'/case-studies/commonspirit-locations-conversion-engine/'},
 {name:'Global commerce',icon:'growth',copy:'Search programs connecting seasonal demand with regional and global storefronts.',href:'/case-studies/apple-seasonal-search/'},
 {name:'AI & software',icon:'automation',copy:'Tools and prototypes for research, reporting and more useful decisions.',href:'/case-studies/claritypulse-ai-reporting/'},
 {name:'Local experiences',icon:'design',copy:'Digital discovery that leads to real-world adventures and customer relationships.',href:'/case-studies/sfc-surf-school/'},
 {name:'Nonprofit',icon:'strategy',copy:'An acquisition system built to help a veterans-services organization reach more people.',href:'/case-studies/vet-advocates-growth-system/'},
 {name:'Industry placeholder',icon:'research',copy:'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.',placeholder:true},
 {name:'Industry placeholder',icon:'engineering',copy:'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.',placeholder:true},
 {name:'Industry placeholder',icon:'measurement',copy:'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt.',placeholder:true},
];
const searchItems = [
 {title:'Services — research, design, engineering & growth',href:'/services/',category:'Services'},
 {title:'Learning lab — data, assumptions & interactive tools',href:'/lab/',category:'Lab'},
 {title:'Software & products',href:'/products/',category:'Products'},
 {title:'Contact Mitchell Miller',href:'/contact/',category:'Contact'},
 {title:'About Mitchell Miller',href:'/about/',category:'About'},
 {title:'Personal portfolio',href:'https://mitchjmiller.com/',category:'Profile'},
 ...caseStudies.map(s=>({title:s.title,href:`/case-studies/${s.slug}/`,category:'Case study'})),
 ...publishedBlogPosts.map(p=>({title:p.title,href:`/blog/${p.slug}/`,category:'Writing'}))
];
const featured = products.filter(p=>p.featured).slice(0,3);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<meta name="robots" content="noindex,nofollow,noarchive"/>
<title>Homepage HTML mockup — Mitchell Miller</title>
<meta name="description" content="Local homepage layout review for Mitchell Miller, using the Contiem reference with proposed copy and interactions."/>
<link rel="icon" href="/favicon.png"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style is:inline>
:root{--navy:#001f46;--heading:#002e5d;--green:#78be20;--pale:#f1f4f9;--gray:#7c878e;--ink:#263746;--width:1280px;font-family:Roboto,Arial,sans-serif;color:var(--ink);background:#fff;font-synthesis:none;color-scheme:light}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-size:18px;line-height:1.5}a{color:var(--heading);text-underline-offset:4px}img{max-width:100%;height:auto}button,input{font:inherit}button,a,input,summary{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--green);outline-offset:5px}h1,h2,h3,p{margin:0}h1,h2,h3{line-height:1.1;font-weight:500;text-wrap:balance}h2{font-size:40px;font-weight:600;color:var(--heading)}h3{font-size:28px;color:var(--heading)}.inner{width:min(var(--width),calc(100% - 40px));margin-inline:auto}.skip{position:absolute;top:-100px;left:20px;background:#fff;padding:12px;z-index:100}.skip:focus{top:12px}
.header{background:white}.identity-row{height:107px;display:flex;align-items:center;justify-content:space-between;gap:20px}.identity{display:flex;align-items:center;gap:14px;text-decoration:none}.identity img{width:56px;height:56px;border-radius:50%;object-fit:cover;object-position:top}.identity strong{font-size:27px;font-weight:500;letter-spacing:-.5px}.identity small{display:block;font-size:14px;color:var(--gray);margin-top:2px}.review-label{font-size:13px;color:var(--gray);text-align:right}.nav-row{display:flex;align-items:center;gap:36px;min-height:54px;padding-bottom:10px}.nav-row nav{display:flex;gap:32px;align-items:center;flex:1}.nav-row nav>a{font-size:20px;text-decoration:none;white-space:nowrap}.nav-row nav>a:hover{text-decoration:underline}.caret{display:inline-block;width:0;height:0;border-inline:4px solid transparent;border-top:6px solid currentColor;margin-left:8px;vertical-align:middle}.search{display:flex;width:232px;border:1px solid #c3c7cc;flex:none;height:38px}.search input{width:100%;min-width:0;border:0;background:white;padding:8px 12px;font-size:14px;color:var(--ink)}.search button{width:40px;flex:none;background:#ededed;border:0;border-left:1px solid #c3c7cc;color:#424b53;cursor:pointer}.search svg{width:18px;height:18px}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}.mobile-nav{display:none}.results{padding:24px 0;border-block:1px solid #d5dae0;background:var(--pale)}.results[hidden]{display:none}.results-head{display:flex;justify-content:space-between;gap:20px}.results h2{font-size:24px}.results button{border:0;background:none;text-decoration:underline;cursor:pointer;color:var(--heading)}.results ul{display:grid;grid-template-columns:repeat(3,1fr);gap:12px 30px;list-style:none;padding:16px 0 0;margin:0}.results li a{display:block;text-decoration:none;font-weight:500}.results li small{display:block;font-size:13px;color:#586973}.results li a:hover{text-decoration:underline}
.hero{background:var(--navy);color:white;text-align:center;padding:74px 0 64px}.hero h1{font-size:54px;line-height:1;max-width:920px;margin:auto}.hero p{max-width:1050px;margin:26px auto 0;font-size:20px;line-height:1.45}.hero .concept{font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#a9bbcf;margin:0 auto 18px}.cta{display:inline-flex;align-items:center;justify-content:center;min-height:52px;padding:16px 26px;border:0;border-radius:4px;background:var(--green);color:var(--navy);font-size:17px;font-weight:600;text-decoration:none;cursor:pointer;line-height:1.2}.cta:hover{background:#8acb3d}.hero .cta{margin-top:32px;min-width:280px}
.brands{padding:25px 0 30px;background:white}.brand-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;gap:20px}.brand-head p{font-size:13px;color:#586973}.motion-toggle{font-size:13px;background:white;border:1px solid #d1d8df;border-radius:3px;min-height:34px;padding:6px 12px;cursor:pointer;color:#586973}.motion-toggle[hidden]{display:none}.marquee{overflow:hidden;width:100%}.track{display:flex;width:max-content;animation:logos 34s linear infinite;will-change:transform}.track ul{display:flex;justify-content:space-around;align-items:center;list-style:none;flex:none;width:1280px;margin:0;padding:0}.track li{display:flex;justify-content:center;align-items:center;width:256px;height:94px;padding:10px 24px}.track img{display:block;width:200px;height:54px;object-fit:contain;max-width:none}.track li[data-brand="Apple"] img{width:30px;height:94px}.track li[data-brand="Stanford Health Care"] img{width:218px;height:40px}.track li[data-brand="Dignity Health"] img{width:190px;height:68px}.track li[data-brand="SFC Surf School"] img{width:66px;height:60px}.marquee:hover .track,.marquee:focus .track,.brands[data-paused="true"] .track{animation-play-state:paused}@keyframes logos{to{transform:translateX(-50%)}}
.lifecycle{background:var(--navy);color:white;text-align:center;padding:28px 0 52px}.lifecycle h2{font-size:32px;color:white}.lifecycle-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin:36px auto 0;max-width:1040px}.stage{color:white;text-decoration:none;padding:0 24px}.stage svg{width:48px;height:48px;color:var(--green);margin:0 auto 18px;display:block}.stage h3{color:#fff;font-size:24px}.stage p{margin-top:15px;font-size:17px;line-height:1.35}.stage:hover h3{text-decoration:underline;text-underline-offset:6px}
.section{text-align:center;padding:60px 0}.section-intro{max-width:1070px;margin:24px auto 0;font-size:20px;line-height:1.5;color:var(--ink)}.help{scroll-margin-top:20px}.help-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:55px}.help-card{display:flex;flex-direction:column;align-items:center;padding:20px;min-width:0}.help-card svg{width:68px;height:68px;color:var(--heading);display:block;margin:0 auto 25px}.help-card h3{min-height:62px;line-height:1.05;font-weight:600}.help-card p{flex:1;margin-top:28px;font-size:17px;line-height:1.55;max-width:32ch}.help-card a{display:flex;align-items:center;justify-content:center;color:var(--heading);background:var(--green);padding:14px 18px;font-size:16px;font-weight:500;text-decoration:none;border-radius:4px;min-height:56px;width:100%;margin-top:32px}.help-card a:hover{background:#8acb3d}
.software{background:var(--pale);padding:30px 0 42px}.software-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:34px auto 0;max-width:1120px}.product{text-decoration:none;display:block;padding:24px 20px;background:#fff;position:relative;color:var(--heading)}.product img{width:100%;height:138px;object-fit:contain;display:block;margin-bottom:18px}.product .product-art{height:138px;display:grid;place-items:center;background:var(--pale);margin-bottom:18px}.product-art svg{width:58px;height:58px;color:var(--heading)}.product h3{font-size:24px}.product small{display:block;color:#5b6c7a;font-size:14px;margin-top:10px}.product:hover h3{text-decoration:underline}.industries-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:55px}.industry{padding:20px 28px 40px}.industry svg{width:72px;height:72px;display:block;margin:0 auto 28px;color:var(--heading)}.industry h3{font-size:24px;line-height:1.2;min-height:58px;display:grid;place-items:center}.industry p{font-size:17px;line-height:1.65;margin:18px auto 0;max-width:29ch}.industry a{text-decoration:none}.industry a:hover{text-decoration:underline}.placeholder{background:var(--pale)}.placeholder small{font-size:12px;color:#596d7b;display:block;margin-top:16px}
.closing{background:var(--navy);color:white;text-align:center;padding:120px 0}.closing h2{font-size:42px;color:white}.closing p{max-width:1020px;font-size:20px;margin:24px auto 0;line-height:1.5}.closing .cta{margin-top:32px;min-width:280px}.footer{padding:28px 0;background:#fff;font-size:14px}.footer .inner{display:flex;justify-content:space-between;gap:24px}.footer nav{display:flex;gap:28px;flex-wrap:wrap}.footer a{color:var(--heading)}
@media(min-width:1600px){.hero{padding-top:84px}.help-card{padding-inline:25px}}
@media(max-width:1050px){.nav-row{gap:18px}.nav-row nav{gap:20px}.nav-row nav>a{font-size:17px}.search{width:195px}.help-grid,.industries-grid{grid-template-columns:repeat(2,1fr)}.help-card h3{min-height:0}.lifecycle-grid{max-width:920px}.stage{padding-inline:10px}.results ul{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.inner{width:calc(100% - 40px)}.identity-row{height:86px}.identity img{width:42px;height:42px}.identity strong{font-size:21px}.identity small{font-size:12px}.review-label{font-size:11px;max-width:85px}.nav-row{display:grid;grid-template-columns:auto 1fr;position:relative;min-height:56px;gap:20px}.nav-row>nav{display:none}.mobile-nav{display:block}.mobile-nav summary{list-style:none;cursor:pointer;color:var(--heading);font-size:17px;padding:8px 0}.mobile-nav summary::-webkit-details-marker{display:none}.mobile-nav nav{position:absolute;top:100%;left:-20px;right:-20px;display:grid;z-index:10;background:white;padding:16px 20px;gap:0;border-block:1px solid #ddd}.mobile-nav nav a{font-size:18px;padding:12px}.search{width:100%;height:38px}.hero{padding:60px 0 56px}.hero h1{font-size:39px;line-height:1.06}.hero p{font-size:18px;line-height:1.55}.hero .concept{font-size:11px}.hero .cta{min-width:230px}.lifecycle-grid{grid-template-columns:repeat(2,1fr);gap:32px 20px}.lifecycle{padding:38px 0 48px}.lifecycle h2{font-size:29px}.stage p{font-size:16px}.stage h3{font-size:22px}.section{padding:52px 0}h2{font-size:32px}.section-intro{font-size:18px}.help-grid{margin-top:25px}.help-card{padding:22px 6px}.help-card h3{font-size:24px;min-height:52px}.help-card p{font-size:16px;margin-top:18px}.help-card a{font-size:15px;padding:12px;margin-top:24px}.help-card svg{width:54px;height:54px}.software{padding:36px 0}.software-grid{grid-template-columns:1fr;max-width:420px}.product{display:grid;grid-template-columns:100px 1fr;gap:0 18px;text-align:left;align-items:center}.product img,.product .product-art{grid-row:1/3;height:90px;width:100px;margin:0}.product h3{font-size:22px}.product small{margin-top:8px}.industries-grid{gap:12px;margin-top:32px}.industry{padding:20px 6px 30px}.industry h3{font-size:22px;min-height:53px}.industry p{font-size:16px}.industry svg{width:58px;height:58px}.closing{padding:80px 0}.closing h2{font-size:34px}.closing p{font-size:18px}.footer .inner{flex-direction:column}.brand-head{gap:12px}.brand-head p{font-size:12px}.motion-toggle{font-size:12px}.track ul{width:1050px}.track li{width:210px;padding:10px 12px}.track li[data-brand="Stanford Health Care"] img{width:194px}.results ul{grid-template-columns:1fr}}
@media(max-width:390px){.hero h1{font-size:35px}.identity{gap:9px}.identity strong{font-size:20px}.help-grid,.industries-grid{column-gap:16px}.help-card h3{font-size:23px}.help-card a{font-size:14px}.help-card p,.industry p{font-size:16px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.track{animation:none;width:100%}.track ul{width:100%;flex-wrap:wrap;justify-content:center;gap:15px}.track ul[aria-hidden="true"]{display:none}.track li{width:220px}.motion-toggle{display:none}}
</style></head><body>
<a class="skip" href="#main">Skip to content</a>
<header class="header"><div class="inner"><div class="identity-row"><a class="identity" href="/"><img src={headshot} alt="" width="56" height="56"/><span><strong>Mitchell Miller</strong><small>Research · Strategy · Design · Engineering</small></span></a><span class="review-label">Homepage mockup<br/>Proposed copy</span></div>
<div class="nav-row"><nav aria-label="Primary"><a href="/about/">About<span class="caret" aria-hidden="true"></span></a><a href="/services/">Services<span class="caret" aria-hidden="true"></span></a><a href="/products/">Software<span class="caret" aria-hidden="true"></span></a><a href="/work/">Work<span class="caret" aria-hidden="true"></span></a><a href="/lab/">Learning lab</a><a href="/blog/">Writing</a><a href="/contact/">Contact</a></nav>
<details class="mobile-nav"><summary>Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile">{[['About','/about/'],['Services','/services/'],['Software','/products/'],['Work','/work/'],['Learning lab','/lab/'],['Writing','/blog/'],['Contact','/contact/']].map(([name,href])=><a href={href}>{name}</a>)}</nav></details>
<form class="search" role="search" id="site-search" action="#search-results"><label class="sr" for="query">Search this site</label><input id="query" name="q" type="search" placeholder="Search here…" maxlength="100" autocomplete="off" required/><button type="submit" aria-label="Search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></button></form></div></div></header>
<section id="search-results" class="results" aria-labelledby="search-title" hidden><div class="inner"><div class="results-head"><h2 id="search-title" tabindex="-1">Search results</h2><button id="close-results" type="button">Close results</button></div><p id="search-count" role="status"></p><ul id="result-list"></ul></div></section>
<noscript><p class="inner">Browse <a href="/work/">the work</a>, <a href="/services/">services</a> or <a href="/blog/">writing</a>. Site search requires JavaScript.</p></noscript>
<main id="main">
<section class="hero" aria-labelledby="hero-heading"><div class="inner"><p class="concept">Proposed welcome</p><h1 id="hero-heading">Welcome to M².<br/>What can we make possible?</h1><p>Research, strategy, design and technology—connected around what you want to achieve.</p><a class="cta" href="#help" id="hero-cta">How can I help?</a></div></section>
<section class="brands" aria-label="Professional experience" id="brand-section"><div class="inner"><div class="brand-head"><p>Professional experience across</p><button class="motion-toggle" type="button" aria-pressed="false" aria-controls="brand-track" hidden>Pause logos</button></div><div class="marquee" tabindex="0" aria-label="Professional brand logos; focus to pause scrolling" role="group"><div class="track" id="brand-track">{[false,true].map(duplicate=><ul aria-hidden={duplicate?'true':undefined}>{logos.map(brand=><li data-brand={brand.name}><img src={brand.logo!} alt={duplicate?'':brand.name} width={'width' in brand?brand.width:undefined} height={'height' in brand?brand.height:undefined}/></li>)}</ul>)}</div></div></div></section>
<section class="lifecycle" aria-labelledby="lifecycle-heading"><div class="inner"><h2 id="lifecycle-heading">Strategy through delivery</h2><div class="lifecycle-grid">{stages.map(s=><a class="stage" href={s.href}><ServiceIcon name={s.icon} label={s.name} decorative/><h3>{s.name}</h3><p>{s.copy}</p></a>)}</div></div></section>
<section class="section help" id="help" tabindex="-1" aria-labelledby="help-heading"><div class="inner"><h2 id="help-heading" tabindex="-1">How can I help?</h2><div class="help-grid">{help.map(item=><article class="help-card"><ServiceIcon name={item.icon} label={item.name} decorative/><h3>{item.name}</h3><p>{item.copy}</p><a href={item.href}>{item.link}</a></article>)}</div></div></section>
<section class="section software" aria-labelledby="software-heading"><div class="inner"><h2 id="software-heading">Software &amp; tools</h2><p class="section-intro">Explore applications for research, reporting and everyday decisions. Try a live tool or follow a product taking shape.</p><div class="software-grid">{featured.map(product=><a class="product" href={product.href}>{product.image?<img src={product.image} alt={product.alt} loading="lazy" width="900" height="600"/>:<div class="product-art"><ServiceIcon name="measurement" label="Data exploration" decorative/></div>}<h3>{product.name}</h3><small>{product.status}</small></a>)}</div></div></section>
<section class="section" aria-labelledby="industries-heading"><div class="inner"><h2 id="industries-heading">Experience across industries</h2><div class="industries-grid">{industries.map(industry=><article class:list={['industry',{placeholder:industry.placeholder}]}><ServiceIcon name={industry.icon} label={industry.name} decorative/><h3>{industry.href?<a href={industry.href}>{industry.name}</a>:industry.name}</h3><p>{industry.copy}</p>{industry.placeholder&&<small>Layout placeholder · not an experience claim</small>}</article>)}</div></div></section>
<section class="closing" aria-labelledby="closing-heading"><div class="inner"><h2 id="closing-heading">Ready to explore further?</h2><p>Bring the question. We’ll work out the next move together—from a clearer direction to the details that make it work.</p><a class="cta" href="/contact/">Start a conversation</a></div></section>
</main><footer class="footer"><div class="inner"><nav aria-label="Footer"><a href="/about/">About</a><a href="https://mitchjmiller.com/">Personal portfolio</a><a href="/review/">Review hub</a><a href="/review/brand-options/">Logo options</a></nav><span>© 2026 Mitchell Miller · HTML layout review</span></div></footer>
<script type="application/json" id="search-index" set:html={JSON.stringify(searchItems).replace(/</g,'\u003c')}/>
<script is:inline>
(()=>{
 const form=document.getElementById('site-search'),input=document.getElementById('query'),panel=document.getElementById('search-results'),list=document.getElementById('result-list'),count=document.getElementById('search-count');
 const index=JSON.parse(document.getElementById('search-index').textContent);
 form.addEventListener('submit',event=>{event.preventDefault();const words=input.value.trim().toLocaleLowerCase().split(/\s+/).filter(Boolean);if(!words.length)return;const matches=index.filter(item=>words.every(word=>(item.title+' '+item.category).toLocaleLowerCase().includes(word)));list.replaceChildren();matches.forEach(item=>{const li=document.createElement('li'),a=document.createElement('a'),meta=document.createElement('small');a.href=item.href;a.textContent=item.title;meta.textContent=item.category;li.append(a,meta);list.append(li)});count.textContent=matches.length?matches.length+' result'+(matches.length===1?'':'s')+' for “'+input.value.trim()+'”.':'No matches. Try research, Apple, or analytics.';panel.hidden=false;document.getElementById('search-title').focus();});
 document.getElementById('close-results').addEventListener('click',()=>{panel.hidden=true;input.focus()});
 form.addEventListener('keydown',event=>{if(event.key==='Escape'){panel.hidden=true;input.focus()}});
 const button=document.querySelector('.motion-toggle'),brands=document.getElementById('brand-section');button.hidden=false;button.addEventListener('click',()=>{const paused=button.getAttribute('aria-pressed')!=='true';button.setAttribute('aria-pressed',String(paused));brands.dataset.paused=String(paused);button.textContent=paused?'Resume logos':'Pause logos'});
})();
</script></body></html>
