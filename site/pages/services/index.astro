---
/**
 * /services/ — new route (manifest kind "added", sitemap 58). Four lifecycle stages
 * with problems solved, typical outputs, working approach and evidence links to
 * existing case studies; brand marquee; process; FAQ (also FAQPage JSON-LD).
 * Truthful: no staff counts, client counts, prices or invented results.
 */
import AgencyLayout from '../../layouts/AgencyLayout.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import BrandMarquee from '../../components/BrandMarquee.astro';
import { site, organizationJsonLd, breadcrumbJsonLd, graph } from '../../lib/agency';

const title = 'Digital Strategy, Design & Engineering — Mitchell Miller';
const description = 'Research, digital strategy, UX and content design, front-end engineering, AI workflows and search growth. Focused support from discovery through delivery.';

const lifecycle = [
  {
    "id": "understand",
    "name": "Understand",
    "line": "Find the opportunity.",
    "icon": "research"
  },
  {
    "id": "design",
    "name": "Design",
    "line": "Make the next step clear.",
    "icon": "design"
  },
  {
    "id": "build",
    "name": "Build",
    "line": "Connect the pieces.",
    "icon": "engineering"
  },
  {
    "id": "grow",
    "name": "Grow",
    "line": "Learn. Refine. Grow.",
    "icon": "growth"
  }
];
// Stage copy adopted from content-studio/drafts/2026-09-14-agency-copy-pack.md §(d); every figure traces to its claims ledger §(i).
const stages = [
  {
    "id": "understand",
    "name": "Understand",
    "kicker": "Research & direction",
    "icon": "research",
    "keyword": "Research",
    "lede": "Research connects customer needs, market signals and performance data so the next decision has a firmer foundation.",
    "outputs": [
      "Market & competitor analysis",
      "Measurement plans",
      "Prioritized recommendations"
    ],
    "approach": "Establish the baseline. Test the assumptions. Turn the findings into decisions your team can use.",
    "evidence": [
      {
        "label": "SFC Surf School",
        "note": "Competitor research shaped the content and discovery experience.",
        "href": "/case-studies/sfc-surf-school/"
      },
      {
        "label": "ClarityPulse",
        "note": "A reporting prototype that keeps evidence close to the decision.",
        "href": "/case-studies/claritypulse-ai-reporting/"
      }
    ]
  },
  {
    "id": "design",
    "name": "Design",
    "kicker": "Content & experience",
    "icon": "design",
    "keyword": "Experience design",
    "lede": "Experience design makes information easier to understand and the next action easier to take.",
    "outputs": [
      "UX/UI direction",
      "Content architecture",
      "Reusable page patterns"
    ],
    "approach": "Connect the journey, the words and the interface. Review the experience where people will use it.",
    "evidence": [
      {
        "label": "Dignity Health location experience",
        "note": "A common structure for location information and patient actions.",
        "href": "/case-studies/commonspirit-locations-conversion-engine/"
      },
      {
        "label": "SFC Surf School",
        "note": "An interactive guide connects real places with a visitor’s decision.",
        "href": "/case-studies/sfc-surf-school/"
      }
    ]
  },
  {
    "id": "build",
    "name": "Build",
    "kicker": "Engineering & connected systems",
    "icon": "engineering",
    "keyword": "Engineering",
    "lede": "Engineering turns the plan into useful interfaces, connected data and repeatable workflows your team can maintain.",
    "outputs": [
      "Front-end development",
      "Database & content structures",
      "AI-assisted workflows"
    ],
    "approach": "Build in reviewable steps. Validate the working pieces. Leave clear ownership and documentation.",
    "evidence": [
      {
        "label": "Location conversion engine",
        "note": "Reusable entities and templates across a large health network.",
        "href": "/case-studies/commonspirit-locations-conversion-engine/"
      },
      {
        "label": "ActionThread",
        "note": "A transcript-to-follow-up workflow documented as an internal tool.",
        "href": "/case-studies/actionthread-transcript-execution/"
      }
    ]
  },
  {
    "id": "grow",
    "name": "Grow",
    "kicker": "Discovery & improvement",
    "icon": "growth",
    "keyword": "Growth strategy",
    "lede": "Growth strategy connects search, content and conversion with a cycle of measurement, learning and improvement.",
    "outputs": [
      "SEO & AI-search plans",
      "Conversion tests",
      "Performance reporting"
    ],
    "approach": "Prioritize useful gains today while protecting the foundations for what comes next.",
    "evidence": [
      {
        "label": "CommonSpirit network consolidation",
        "note": "Search continuity and growth through enterprise migrations.",
        "href": "/case-studies/commonspirit-network-consolidation/"
      },
      {
        "label": "SFC Surf School",
        "note": "Measured search changes with the dates and release boundaries shown.",
        "href": "/case-studies/sfc-surf-school/"
      }
    ]
  }
];
const process = [
  {
    "name": "Define the question.",
    "body": "Agree what matters, who it serves and what success would mean."
  },
  {
    "name": "Find the evidence.",
    "body": "Inspect the data, constraints and assumptions shaping the decision."
  },
  {
    "name": "Make it useful.",
    "body": "Review the strategy, content or software as it develops."
  },
  {
    "name": "Learn from the result.",
    "body": "Measure what changed and decide what deserves attention next."
  }
];
const faq = [
  {
    "q": "Who will I work with?",
    "a": "Mitchell Miller leads the work directly, from research and strategy through hands-on delivery. The scope determines any additional specialist support."
  },
  {
    "q": "What does an engagement cost?",
    "a": "Cost follows the question, scope and deliverables. Start with a conversation; agree the work before it begins."
  },
  {
    "q": "Do you work with smaller businesses?",
    "a": "Yes. The work spans enterprise programs and independent businesses, with the approach shaped to the opportunity."
  },
  {
    "q": "Is there a free way to explore the approach?",
    "a": "Yes. The learning lab offers interactive tools for exploring data, testing assumptions and comparing scenarios."
  },
  {
    "q": "How are results measured?",
    "a": "Agree the baseline and success measures first. Reports connect each result to its source, time period and limits. The case studies show that discipline in practice."
  },
  {
    "q": "Can you work with our existing team?",
    "a": "Yes. Work can complement your engineering, design, marketing or analytics team through shared priorities, clear requirements and practical handoffs."
  }
];
const jsonLd = [graph(
  organizationJsonLd(),
  {
    '@type': 'Service', '@id': `${site.url}/services/#service`, name: 'Digital strategy, design and engineering', serviceType: 'Digital strategy, design and engineering',
    provider: { '@id': `${site.url}/#organization` }, areaServed: 'United States', url: `${site.url}/services/`, description,
    hasOfferCatalog: { '@type': 'OfferCatalog', name: 'Services by stage', itemListElement: stages.map(stage => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name: `${stage.name} — ${stage.kicker}`, description: stage.lede, url: `${site.url}/services/#${stage.id}` } })) },
  },
  { '@type': 'FAQPage', '@id': `${site.url}/services/#faq`, mainEntity: faq.map(item => ({ '@type': 'Question', name: item.q, acceptedAnswer: { '@type': 'Answer', text: item.a } })) },
  breadcrumbJsonLd([{ name: 'Home', href: '/' }, { name: 'Services', href: '/services/' }]),
)];
---
<AgencyLayout path="/services/" title={title} description={description} jsonLd={jsonLd} bodyClass="ag-services">
  <section class="ag-hero ag-hero--compact ag-dark" aria-labelledby="services-heading">
    <div class="ag-wrap ag-hero-grid">
      <div>
        <ol class="ag-crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li aria-current="page">Services</li></ol>
        <p class="ag-eyebrow">Services</p>
        <h1 id="services-heading">See the opportunity.<br />Bring it to life.</h1>
        <p class="ag-hero-deck">Research, design and technology around one question: what will make the most useful difference?</p>
        <div class="ag-hero-actions"><a class="ag-button" href="/contact/">Start a conversation</a></div>
      </div>
    </div>
  </section>

  <BrandMarquee id="services-brands" />

  <section class="ag-lifecycle" aria-label="Stages of the work">
    <div class="ag-wrap">
      <p class="ag-lifecycle-label">Strategy through delivery</p>
      <ol>{lifecycle.map(stage => <li><a href={`#${stage.id}`}><ServiceIcon name={stage.icon} label={stage.name} decorative /><strong>{stage.name}</strong><span>{stage.line}</span></a></li>)}</ol>
    </div>
  </section>

  <div class="ag-wrap">
    {stages.map((stage, index) => <section class="ag-stage" aria-labelledby={`${stage.id}-heading`}>
      <div class="ag-stage-head">
        <ServiceIcon name={stage.icon} label={stage.keyword} />
        <p class="ag-eyebrow">{stage.kicker}</p>
        <h2 id={stage.id}><span id={`${stage.id}-heading`}>{stage.name}</span></h2>
        <p class="ag-stage-lede">{stage.lede}</p>
      </div>
      <ul class="ag-stage-outputs" aria-label={`${stage.name} deliverables`}>{stage.outputs.map(item => <li>{item}</li>)}</ul>
      <p class="ag-stage-approach">{stage.approach}</p>
      <details class="ag-stage-proof"><summary>Explore the work <span aria-hidden="true">+</span></summary><ul>{stage.evidence.map(item => <li><a href={item.href}>{item.label}</a><p>{item.note}</p></li>)}</ul></details>
    </section>)}
  </div>

  <section class="ag-section ag-section--tint" id="process" aria-labelledby="process-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">Process</p><h2 id="process-heading">Start small. See clearly. Move forward.</h2><p>Clear priorities. Shared progress. A useful next step.</p></div></div>
      <ol class="ag-process">{process.map(step => <li><h3>{step.name}</h3><p>{step.body}</p></li>)}</ol>
    </div>
  </section>

  <section class="ag-section" aria-labelledby="faq-heading">
    <div class="ag-wrap">
      <div class="ag-section-head"><div><p class="ag-eyebrow">FAQ</p><h2 id="faq-heading">Frequently asked questions</h2></div></div>
      <div class="ag-faq">{faq.map(item => <details><summary><h3>{item.q}</h3><span aria-hidden="true">+</span></summary><p>{item.a}{item.q.startsWith('Is there a free way') && <> <a href="/lab/">Explore the lab.</a></>}</p></details>)}</div>

    </div>
  </section>

  <section class="ag-cta ag-dark" aria-labelledby="services-cta-heading">
    <div class="ag-wrap ag-cta-inner">
      <div><p class="ag-eyebrow">Ready to explore further?</p><h2 id="services-cta-heading">What are you imagining?</h2><p>Bring the question. We’ll work out the next move together.</p></div>
      <div class="ag-cta-actions"><a class="ag-button" href="/contact/">Start a conversation</a></div>
    </div>
  </section>
</AgencyLayout>
