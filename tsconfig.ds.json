{
  "include": ["src/ds/**/*"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "lib": ["esnext", "dom", "dom.iterable"],
    "declaration": true,
    "noEmit": false,
    "outDir": "ds-dist",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": []
  }
}
